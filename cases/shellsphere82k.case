# Generic shellSphere 82ktet normal-flow case.
#
# patch_0_0 : wall
# patch_1_0 : normal-speed inlet
# patch_2_0 : pressure-0/open outlet
#
# Swap patch_1_0 and patch_2_0 if the desired flow direction is reversed.

[run]
name = shellSphere82k
ranks = 16
output_root = auto

[solver]
mesh = ~/NodalS v1.00/meshes/shellsphere1/82ktet/constant/polyMesh
problem = flow
nu = 0.001
convection = central

[boundary]
wall_patch = patch_0_0
wall_type = wall

inlet_patch = patch_1_0
inlet_type = normal
speed = 0.2

outlet_patch = patch_2_0
outlet_type = pressure0

[supg]
enabled = false
tau_scale = 0.05
form = implicit
kernel = fast
quad_points = 64

[simple]
variant = simplec
rtol = 1e-3
max_iterations = 10000
alpha_u = 0.7
alpha_p = 0.3
u_relax_mode = row_l1
rau_mode = diag
rau_scale = 1

[momentum]
rtol = 1e-8
atol = 0
relative_drop = 0.5
max_iterations = 20000
check_every = 1
local_sweeps = 1
sor_omega = 1

[pressure]
mode = fast_full_gamg
pmat = full
refresh = 100
rtol = 0.5
atol = 1e-12
max_iterations = 20
pc_type = gamg
mg_level_ksp = richardson
mg_level_pc = jacobi
mg_level_iterations = 1

[output]
write_vtu = true
resource_profile = true
memory_audit = false
