# NodalS v1.00 canonical fast case
# 40k Hagen-Poiseuille, Re=20

[run]
name = 40k_Re20_fast_full_gamg
ranks = 16
output_root = auto

[solver]
mesh = ~/NodalS v1.00/meshes/pipe/40k/constant/polyMesh
problem = pipe
re = 20
convection = central

[boundary]
wall_patch = patch_0_0
wall_type = wall
inlet_patch = patch_2_0
inlet_type = parabolic
bulk_velocity = 1.0
outlet_patch = patch_1_0
outlet_type = pressure0

[supg]
enabled = false

[simple]
variant = simple
rtol = 1e-3
max_iterations = 2000
alpha_u = 0.5
alpha_p = 0.5
u_relax_mode = row_l1
rau_mode = diag
rau_scale = 1

[momentum]
rtol = 1e-8
atol = 0
relative_drop = 0.1
max_iterations = 20000
check_every = 1
local_sweeps = 1
sor_omega = 1

[pressure]
mode = fast_full_gamg
pmat = full
refresh = 100
rtol = 0.5
atol = 1e-12
max_iterations = 20
pc_type = gamg
mg_level_ksp = richardson
mg_level_pc = jacobi
mg_level_iterations = 1

[output]
write_vtu = false
resource_profile = true
memory_audit = false
