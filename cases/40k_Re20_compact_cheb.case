# Same 40k Re=20 pipe, but compact low-memory pressure architecture.

[run]
name = 40k_Re20_compact_cheb
ranks = 16
output_root = auto

[solver]
mesh = ~/NodalS v1.00/meshes/pipe/40k/constant/polyMesh
problem = pipe
re = 20
convection = central

[boundary]
wall_patch = patch_0_0
wall_type = wall
inlet_patch = patch_2_0
inlet_type = parabolic
bulk_velocity = 1.0
outlet_patch = patch_1_0
outlet_type = pressure0

[supg]
enabled = false

[simple]
variant = simple
rtol = 1e-3
max_iterations = 2000
alpha_u = 0.5
alpha_p = 0.5
u_relax_mode = row_l1
rau_mode = diag
rau_scale = 1

[momentum]
rtol = 1e-8
atol = 0
relative_drop = 0.1
max_iterations = 20000
check_every = 1
local_sweeps = 1
sor_omega = 1

[pressure]
mode = compact_cheb
pmat = compact
refresh = 1
rtol = 0.1
atol = 1e-12
max_iterations = 300
pc_type = gamg

[chebyshev]
mode = adaptive
power_iterations = 10
spectrum_refresh = 100
lambda_max_safety = 1.2
lambda_min_fraction = 0.06
rtol = 0.1
atol = 1e-12
initial_block = 8
extend_block = 4
max_steps = 40

[output]
write_vtu = true
resource_profile = true
memory_audit = false
