NVCC ?= $(shell command -v nvcc 2>/dev/null || { for c in /usr/local/cuda/bin/nvcc /usr/local/cuda-*/bin/nvcc /opt/cuda/bin/nvcc; do if [ -x "$$c" ]; then echo "$$c"; break; fi; done; })
ifeq ($(strip $(NVCC)),)
$(error nvcc not found; set NVCC=/full/path/to/nvcc)
endif
ARCH ?= sm_86
NVCCFLAGS ?= -O3 -std=c++17 -lineinfo -Xcompiler=-Wall,-Wextra

