clean:
	rm -f nodals_hxt5b_fp64 nodals_hxt5b_fp32 libnodals_sst_runtime.a $(SST_HOST_OBJECTS)

.PHONY: all clean

# Stage16 independent compiled HOST interfaces, linked into CUDA executable.
# The existing CUDA physics kernels remain in the accepted single TU.
SST_CXX ?= g++
SST_CXXFLAGS ?= -O3 -std=c++17 -Wall -Wextra
SST_HOST_OBJECTS := modules/physics/sst2003m_host.o modules/wall/portable/wall_host.o modules/transport/portable/transport_host.o modules/coupling/portable/coupling_host.o modules/runtime/compiled_gate.o modules/runtime/model_dispatch.o
libnodals_sst_runtime.a: $(SST_HOST_OBJECTS)
	$(AR) rcs $@ $(SST_HOST_OBJECTS)
modules/physics/%.o: modules/physics/%.cpp
	$(SST_CXX) $(SST_CXXFLAGS) -c $< -o $@
modules/wall/portable/%.o: modules/wall/portable/%.cpp
	$(SST_CXX) $(SST_CXXFLAGS) -c $< -o $@
# Keep portable CPU wall implementation in sync with the optimized GPU wall mathematics.
modules/wall/portable/wall_host.o: modules/wall/portable/spalding_core.hpp modules/wall/portable/spalding_active.hpp modules/wall/portable/stage27_s02c3_shared_fit.hpp
modules/transport/portable/%.o: modules/transport/portable/%.cpp
	$(SST_CXX) $(SST_CXXFLAGS) -c $< -o $@
modules/coupling/portable/%.o: modules/coupling/portable/%.cpp
	$(SST_CXX) $(SST_CXXFLAGS) -c $< -o $@
modules/runtime/%.o: modules/runtime/%.cpp modules/runtime/model_dispatch.hpp modules/coupling/portable/coupling_core.hpp
	$(SST_CXX) $(SST_CXXFLAGS) -c $< -o $@

# Stage3 native P2 live-scalar pilot is compile-only opt-in, not coupled P2.
