SST_ALPHA_K="${SST_ALPHA_K:-0.70}"
SST_ALPHA_OMEGA="${SST_ALPHA_OMEGA:-0.70}"
MOM_RTOL="${MOM_RTOL:-1e-6}"
MOM_ATOL="${MOM_ATOL:-0}"
MOM_MAX="${MOM_MAX:-800}"
MOM_FGMRES_RESTART="${MOM_FGMRES_RESTART:-30}"
P_RTOL="${P_RTOL:-1e-6}"
P_ATOL="${P_ATOL:-1e-12}"
P_MAX="${P_MAX:-600}"
K_RTOL="${K_RTOL:-1e-6}"
K_ATOL="${K_ATOL:-0}"
OMEGA_RTOL="${OMEGA_RTOL:-1e-6}"
OMEGA_ATOL="${OMEGA_ATOL:-0}"
SST_STATE_SPACE="${SST_STATE_SPACE:-bernstein_q2}"
SST_G2_PHYSICAL_GATE="${SST_G2_PHYSICAL_GATE:-1}"
SST_PROFILE5_EQ_GAMMA="${SST_PROFILE5_EQ_GAMMA:-500}"
MAX_OUTER="${MAX_OUTER:-20}"
SST_G2_MAX="${SST_G2_MAX:-20}"
SST_OMEGA_WALL_MODE="${SST_OMEGA_WALL_MODE:-of_auto}"
SST_OF_PRODUCTION="${SST_OF_PRODUCTION:-0}"
PURETET_OMEGA_AUDIT_EVERY="${PURETET_OMEGA_AUDIT_EVERY:-0}"
