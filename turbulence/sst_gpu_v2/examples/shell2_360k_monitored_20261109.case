# Shell2 same 368,200-tet, Re=1000 nominal low-Re case from 2026-11-07.
# Experimental model: advective, vector Laplacian, no full-residual SUPG.
# Existing P1+BF3 velocity, P0 pressure, masked-P1 k/omega (editable).
# Physical rho=1000 kg/m3; mu=0.01460735 Pa.s; native pressure is p/rho.
# Only monitor display multiplies kinematic pressure drop by 1000 for Pa.
# This file is freely editable; change any [convection], [stress], [sst], [simple].

[mesh]
format = msh2
path = shell2_360k_tet.msh
diameter = 0.02791368534450765

[physics]
density = 1
reynolds = 1000
kinematic_viscosity = 1.460735e-05

[inlet.main]
mode = velocity
velocity = (0, -0.5233042437685201, 0)

[outlet.main]
type = open

[wall.main]
type = spalding

[initialization]
mode = potential_flow

[wall_distance]
method = geometric

[wall_sampling]
initial_distance = first_cell_centroid
corner_angle_degrees = 45
thin_channel_policy = centroid_fallback_warn
mode = ray_trace
max_crossings = 4096
bary_tolerance = 1e-9

[wall_function]
law = spalding
samples = 1
spalding_sample_scale = auto
zero_limit = true
nitsche_gamma = 1e-6
face_spalding = true
frozen_wall_cache = true
shared_wall_state = true
integral_utau = true
integral_nq = 12

[omega_wall]
method = of_auto
sample_index = 3
sample_scale = auto
gamma = 1000000
production = false
stage41_mode = trace_log
trace_gamma = 100000

[sst]
state_space = q1
compact_p1 = false
intensity = 0.05
length_ratio = 0.07
ur_k = 0.7
ur_omega = 0.7
k_solver = fgs-fixed
omega_solver = fgs-fixed
k_sweeps = 2
omega_sweeps = 2
check_every = 0

[simple]
max_iterations = 500
physical_gate = false
ur_u = 0.7
ur_p = 0.99
simple_tol = 1e-14
continuity_atol = 1e-30
plateau_tol = 1e-14
plateau_samples = 5

[solver.u]
method = m3-fgs
sweeps = 2
omega = 0.7
rtol = 1e-6
atol = 0
max_iterations = 800
restart = 30

[solver.p]
method = pcg_amg
rtol = 1e-1
atol = 1e-12
max_iterations = 600

[amg]
hierarchy = cf
coarsening = pmis
strength = classical-negative
interpolation = exti
theta = 0.25
terminal = 1000
smoother = mcgs
fine_mode = explicit
fine_sweeps = 1
coarse_sweeps = 1

[supg]
momentum = false
k = false
omega = false
tau_scale = 0.05
nu_fd_rel = 0.001
k_tau_scale = 0.05
omega_tau_scale = 0.05

[restart]
path =

[output]
console = compact
print_every = 10
metrics_every = 10
diagnostics_every = 0
legacy_final_diagnostics = false
vtu_every = 100
checkpoint_every = 100
profile = false
profile_audit = false
directory = ~/NodalS_SST_LOCAL_RUNS/SHELL2_360K_MONITORED_ADVECTIVE_20261109
live_monitor = true
monitor_refresh_seconds = 3
monitor_pressure_scale = 1000

[environment]

[adaptive_sampling]
enabled = true
first_refresh = 100
refresh_every = 500
max_refreshes = 1
target_spalding_yplus = 50
target_omega_yplus = 50
min_scale = 0.05
max_scale = 0.90

[native]
amg-mcgs-order = symmetric
amg-mcgs-fine-sweeps = 1
amg-mcgs-coarse-sweeps = 1
amg-mcgs-omega = 1.0

[convection]
form = advective

[stress]
form = vector_laplacian

[convergence]
metric = legacy
relative_tolerance = 0.01
window_iterations = 25
require_residuals = true
