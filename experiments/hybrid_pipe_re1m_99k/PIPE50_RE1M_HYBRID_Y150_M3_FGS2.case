# HYBRID COUPLED MOMENTUM V1 — m3-fgs with exactly TWO forward-colour block sweeps.
# To compare same operator with reference FGMRES: solver.u.method = coupled-fgmres
# Native NODALS_HYBRID_COUPLED_CONFIG must explicitly report mode=m3-fgs.
# Current vector_laplacian/legacy wall has no off-component momentum blocks;
# this is a linear solver port, NOT a full-vector HEX wall reformulation.
# Re1M YPLUS150 TRACE_LOG: new independent run; ~99k hybrid HEX/TET cells
# Wall ring nominal full thickness 6.99033 mm (sample at half = 3.49516 mm).
# HXT1_mesh.bin generated by RUN_Y150_TRACE_LOG.sh with --sample-yplus 150.
# Stage41 mode=trace_log: PURE log omega target at the single HEX centroid
# imposed at physical HEX wall face by existing symmetric Nitsche kernel.
# Mesh is generated on your workstation by this branch's RUN.sh prepare
# as WORK/mesh/HXT1_mesh.bin. The runner copies this case to WORK/cases.
# A local source patch is needed; main's puretet runner cannot run this case.
[mesh]
format = hxt1
path = ../mesh/HXT1_mesh.bin
hybrid = true
diameter = 0.889

[physics]
density = 1
reynolds = 1000000
kinematic_viscosity = 1.460734693878e-5

[inlet.main]
mode = velocity
velocity = (0, 0, 16.431211404701912)

[outlet.main]
type = open

[wall.main]
type = spalding

[initialization]
mode = plug

[wall_distance]
# Straight circular pipe: native analytic distance, no tet-only BVH
method = analytic_pipe

[wall_sampling]
initial_distance = legacy_scale
mode = ray_trace
max_crossings = 4096
bary_tolerance = 1e-9

[wall_function]
law = spalding
samples = 1
spalding_sample_scale = 0.5
distances = 0.001, 0.003, 0.00699, 0.010, 0.013
zero_limit = true
# Hybrid HEX/TET interface Nitsche gamma (NOT the omega-wall gamma).
# Historical hybrid default: 50; 1e-6 was effectively unstabilized.
nitsche_gamma = 50
face_spalding = false
frozen_wall_cache = false
shared_wall_state = true
integral_utau = false
integral_nq = 12

[omega_wall]
method = of_auto
sample_index = 3
sample_scale = 0.5
gamma = 1000000
production = false
stage41_mode = trace_log
trace_gamma = 50
trace5_gamma = 0

[sst]
state_space = q1
compact_p1 = false
intensity = 0.05
length_ratio = 0.07
ur_k = 0.7
ur_omega = 0.7
k_solver = fgs-fixed
omega_solver = fgs-fixed
k_sweeps = 2
omega_sweeps = 2
check_every = 0

[simple]
max_iterations = 1000
physical_gate = false
ur_u = 0.7
ur_p = 0.9
simple_tol = 1e-12
continuity_atol = 1e-30
plateau_tol = 1e-14
plateau_samples = 5

[solver.u]
method = m3-fgs
sweeps = 2
omega = 0.7
rtol = 1e-5
atol = 0
max_iterations = 800
restart = 30

[solver.p]
method = pcg_amg
rtol = 1e-1
atol = 1e-12
max_iterations = 600

[amg]
hierarchy = cf
coarsening = pmis
strength = classical-negative
interpolation = exti
theta = 0.25
terminal = 1000
smoother = mcgs
fine_mode = explicit
fine_sweeps = 1
coarse_sweeps = 1

[supg]
momentum = false
k = false
omega = false
tau_scale = 0.05
nu_fd_rel = 0.001
k_tau_scale = 0.05
omega_tau_scale = 0.05

[restart]
path =

[output]
console = compact
print_every = 10
metrics_every = 10
diagnostics_every = 0
legacy_final_diagnostics = false
vtu_every = 100
checkpoint_every = 100
profile = false
profile_audit = false
directory = ~/NodalS_SST_LOCAL_RUNS/PIPE50_RE1M_HYBRID_Y150_M3_FGS2
live_monitor = true
monitor_refresh_seconds = 3
monitor_pressure_scale = 1.225

[environment]

[adaptive_sampling]
enabled = false
first_refresh = 50
refresh_every = 200
max_refreshes = 0
target_spalding_yplus = 150
target_omega_yplus = 150
min_scale = 0.02
max_scale = 1.0

[native]
amg-mcgs-order = symmetric
amg-mcgs-fine-sweeps = 1
amg-mcgs-coarse-sweeps = 1
amg-mcgs-omega = 1.0

[convection]
form = advective

[stress]
form = vector_laplacian

[convergence]
metric = legacy
relative_tolerance = 0.01
window_iterations = 25
require_residuals = true
