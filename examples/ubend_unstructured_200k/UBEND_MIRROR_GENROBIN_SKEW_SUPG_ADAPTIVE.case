# NodalS 180-degree U-bend: MIRROR-SYMMETRIC STRUCTURED-SPLIT 199,584-tet mesh.
# Generalized Robin-Nitsche + skew-symmetric full-residual momentum SUPG.
# Re=72600, D=0.0889 m, nu=1.460734693878e-5 m2/s, bulk=11.9290594798 m/s.
# Developed inlet from Stage27 predecessor; interpolated with original flux preserved.
# This case is editable: no mesh/name/convection locks in the canonical launcher.
# Automatic y+ stage transitions are managed by nodals.py run:
# iterations 1-50 fixed initial .10/.10; iterations 51-500 use facewise y+=30.
# To remove refresh: [adaptive_sampling] enabled=false.

[mesh]
format = msh2
path = ~/Downloads/NODALS_STAGE27_UBEND_50K/azore_u_bend_structured_200k_MIRROR_SYMMETRIC.msh
diameter = 0.0889

[physics]
density = 1
reynolds = 72600
kinematic_viscosity = 1.460734693878e-5

[inlet.main]
mode = velocity
velocity = (11.9290594798, 0, 0)
profile_csv = ~/Downloads/STAGE27_DG_PROFILE_V1_PACKAGE/inlet_profile_developed_it1500.csv
profile_mapping = interpolate
profile_flux = preserve
profile_corner_epsilon = 1e-9

[outlet.main]
type = open

[wall.main]
type = spalding

[initialization]
mode = potential_flow

[wall_distance]
method = geometric

[wall_sampling]
mode = ray_trace
max_crossings = 4096
bary_tolerance = 1e-9

[wall_function]
law = spalding
samples = 1
spalding_sample_scale = 0.10
zero_limit = true
nitsche_gamma = 1e-6
face_spalding = true
frozen_wall_cache = true
shared_wall_state = true
integral_utau = true
integral_nq = 12
boundary_form = generalized_robin_nitsche
tangential_consistency = off
stabilization_c = 15.0
consistency_viscosity = nu

[omega_wall]
method = of_auto
sample_index = 3
sample_scale = 0.10
gamma = 1000000
production = false
stage41_mode = trace_log
trace_gamma = 100000

[sst]
state_space = q1
compact_p1 = false
intensity = 0.05
length_ratio = 0.07
ur_k = 0.3
ur_omega = 0.3
k_solver = fgs-fixed
omega_solver = fgs-fixed
k_sweeps = 2
omega_sweeps = 2
check_every = 0

[simple]
max_iterations = 500
physical_gate = false
ur_u = 0.7
ur_p = 0.3
simple_tol = 1e-4
continuity_atol = 1e-8
plateau_tol = 0.001
plateau_samples = 5

[solver.u]
method = m3-fgs
sweeps = 5
omega = 0.7
rtol = 1e-4
atol = 0
max_iterations = 150
restart = 20

[solver.p]
method = pcg_amg
rtol = 0.1
atol = 1e-12
max_iterations = 600

[amg]
hierarchy = cf
coarsening = pmis
strength = classical-negative
interpolation = exti
theta = 0.25
terminal = 1000
smoother = mcgs
fine_mode = explicit
fine_sweeps = 1
coarse_sweeps = 1

[convection]
form = skew_symmetric

[stress]
form = deviatoric

[supg]
momentum = true
k = false
omega = false
tau_scale = 0.05
nu_fd_rel = 0.001
k_tau_scale = 0.05
omega_tau_scale = 0.05

[restart]
path =

[output]
console = compact
print_every = 5
metrics_every = 5
diagnostics_every = 10
legacy_final_diagnostics = false
vtu_every = 50
checkpoint_every = 50
profile = false
profile_audit = false
directory = ~/NodalS_SST_LOCAL_RUNS/ubend_mirror_200k_genrobin_adaptive

[adaptive_sampling]
enabled = true
first_refresh = 50
refresh_every = 500
max_refreshes = 1
target_spalding_yplus = 30
target_omega_yplus = 30
min_scale = 0.05
max_scale = 0.90

[native]
amg-mcgs-order = symmetric
amg-mcgs-fine-sweeps = 1
amg-mcgs-coarse-sweeps = 1
amg-mcgs-omega = 1.0
