+// Lightweight alternative smoother: exactly one undamped Jacobi correction.
+// No lambda estimate, power iteration, Chebyshev roots, or level SpMV is
+// required to form this correction.  The V-cycle remains symmetric because
+// the identical diagonal operator is used before and after coarse correction.
+static PetscErrorCode customPressureAMGJacobiCorrection(CustomPressureAMGRuntime& R,PetscInt lev,
+  const std::vector<double>& rhs,std::vector<double>& corr) {
+  PetscFunctionBeginUser;
+  auto& L=R.amg.levels[(std::size_t)lev];
+  const auto& d=L.A.diagonal;
+  const PetscInt n=L.localEnd-L.localStart;
+  if((PetscInt)rhs.size()!=n || (PetscInt)d.size()!=n)
+    SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_ARG_SIZ,"custom AMG Jacobi vector size mismatch");
+  corr.resize((std::size_t)n);
+  for(PetscInt i=0;i<n;++i) {
+    const double di=d[(std::size_t)i];
+    if(!(di>0.0) || !std::isfinite(di))
+      SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_FP,"custom AMG Jacobi diagonal invalid");
+    corr[(std::size_t)i]=rhs[(std::size_t)i]/di;
+  }
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
+
+// Exact processor-local fine pressure block SGS without materializing the
+// fine Schur CSR. The local block is A_rr = B_r diag(rAU) B_r^T. During the
+// sweep we maintain q_d = diag(rAU) B_d^T x incrementally. A pressure-row
+// update therefore costs only its eight enriched-P1 supports in each component.
+// Off-rank pressure unknowns are fixed at zero during the local block solve,
+// exactly matching processor-block Jacobi semantics. Ghost rAU values are
+// exchanged once per SGS correction; no pressure halo exchange is required.
+static PetscErrorCode customPressureAMGFineBlockSGSCorrection(CustomPressureAMGRuntime& R,
+  const std::vector<double>& rhs,std::vector<double>& corr,int tagBase) {
+  PetscFunctionBeginUser;
+  auto *Bp=R.exactCtx.B;
+  const auto *Mp=R.exactCtx.M;
+  if(!Bp || !Mp) SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_ARG_NULL,"custom AMG fine SGS missing B/rAU context");
+  auto& B=*Bp; const auto& M=*Mp; auto& L=R.amg.levels[0];
+  const PetscInt n=L.localEnd-L.localStart;
+  if((PetscInt)rhs.size()!=n || (PetscInt)L.A.diagonal.size()!=n ||
+     (PetscInt)B.forwardCells.size()!=n)
+    SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_ARG_SIZ,"custom AMG fine SGS size mismatch");
+  if((PetscInt)M.rAU.size()!=B.velocityHalo.nOwned)
+    SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_ARG_SIZ,"custom AMG fine SGS rAU ownership mismatch");
+
+  PetscCall(customPeerExchange(B.velocityHalo,M.rAU,tagBase));
+  const PetscInt nv=B.velocityHalo.nOwned+(PetscInt)B.velocityHalo.ghostGid.size();
+  std::array<std::vector<double>,3> q;
+  for(auto& v:q) v.assign((std::size_t)nv,0.0);
+  corr.assign((std::size_t)n,0.0);
+
+  for(PetscInt i=0;i<n;++i)
+    if(B.forwardCells[(std::size_t)i].pLocal!=i)
+      SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_PLIB,"custom AMG fine SGS pressure-row ordering mismatch");
+
+  auto rowAction=[&](PetscInt i)->double {
+    const auto& cp=B.forwardCells[(std::size_t)i];
+    double s=0.0;
+    for(int d=0;d<3;++d)
+      for(int a=0;a<8;++a) if(cp.velLocal[a]>=0)
+        s+=customPressureBCoeff(cp.vol,cp.gradLambda,d,a)*q[(std::size_t)d][(std::size_t)cp.velLocal[a]];
+    return s;
+  };
+
+  auto addRow=[&](PetscInt i,double delta) {
+    const auto& cp=B.forwardCells[(std::size_t)i];
+    for(int d=0;d<3;++d)
+      for(int a=0;a<8;++a) if(cp.velLocal[a]>=0) {
+        const PetscInt li=cp.velLocal[a];
+        const double b=customPressureBCoeff(cp.vol,cp.gradLambda,d,a);
+        const double rau=customPeerValue(B.velocityHalo,M.rAU,li);
+        q[(std::size_t)d][(std::size_t)li]+=rau*b*delta;
+      }
+  };
+
+  // Forward GS solve from zero.
+  for(PetscInt i=0;i<n;++i) {
+    const double di=L.A.diagonal[(std::size_t)i];
+    if(!(di>0.0) || !std::isfinite(di))
+      SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_FP,"custom AMG fine SGS diagonal invalid");
+    const double delta=(rhs[(std::size_t)i]-rowAction(i))/di;
+    corr[(std::size_t)i]+=delta;
+    addRow(i,delta);
+  }
+
+  // Backward GS sweep on the same equation. Forward+backward is one SGS
+  // correction, i.e. (D+U)^-1 D (D+L)^-1 applied to rhs.
+  for(PetscInt ii=n;ii-->0;) {
+    const double di=L.A.diagonal[(std::size_t)ii];
+    const double delta=(rhs[(std::size_t)ii]-rowAction(ii))/di;
+    corr[(std::size_t)ii]+=delta;
+    addRow(ii,delta);
+  }
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
+
+// Coarse levels already own explicit custom FP64 CSR. SGS is applied only to
+// the rank-owned principal block; ghost columns are frozen at zero during the
+// correction. This is symmetric processor-block SGS and introduces no extra
+// retained matrix storage.
+static PetscErrorCode customPressureAMGCoarseBlockSGSCorrection(CustomPressureAMGRuntime& R,
+  PetscInt lev,const std::vector<double>& rhs,std::vector<double>& corr) {
+  PetscFunctionBeginUser;
+  auto& A=R.amg.levels[(std::size_t)lev].A;
+  const PetscInt n=A.localEnd-A.localStart;
+  if((PetscInt)rhs.size()!=n || (PetscInt)A.rowPtr.size()!=n+1 ||
+     (PetscInt)A.diagonal.size()!=n)
+    SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_ARG_SIZ,"custom AMG coarse SGS size mismatch");
+  corr.assign((std::size_t)n,0.0);
+
+  auto rowAction=[&](PetscInt i)->double {
+    double s=0.0;
+    for(PetscInt k=A.rowPtr[(std::size_t)i];k<A.rowPtr[(std::size_t)i+1];++k) {
+      const PetscInt j=A.colLocal[(std::size_t)k];
+      if(j>=0 && j<n) s+=A.values[(std::size_t)k]*corr[(std::size_t)j];
+    }
+    return s;
+  };
+
+  for(PetscInt i=0;i<n;++i) {
+    const double di=A.diagonal[(std::size_t)i];
+    if(!(di>0.0) || !std::isfinite(di))
+      SETERRQ(PETSC_COMM_WORLD,PETSC_ERR_FP,"custom AMG coarse SGS diagonal invalid");
+    corr[(std::size_t)i]+=(rhs[(std::size_t)i]-rowAction(i))/di;
+  }
+  for(PetscInt ii=n;ii-->0;) {
+    const double di=A.diagonal[(std::size_t)ii];
+    corr[(std::size_t)ii]+=(rhs[(std::size_t)ii]-rowAction(ii))/di;
+  }
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
+
+static PetscErrorCode customPressureAMGSGSCorrection(CustomPressureAMGRuntime& R,PetscInt lev,
+  const std::vector<double>& rhs,std::vector<double>& corr,int tagBase) {
+  PetscFunctionBeginUser;
+  if(lev==0) PetscCall(customPressureAMGFineBlockSGSCorrection(R,rhs,corr,tagBase));
+  else PetscCall(customPressureAMGCoarseBlockSGSCorrection(R,lev,rhs,corr));
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
+
+static PetscErrorCode customPressureAMGSmoothingCorrection(CustomPressureAMGRuntime& R,PetscInt lev,
+  const std::vector<double>& rhs,std::vector<double>& corr,int tagBase) {
+  PetscFunctionBeginUser;
+  if(R.amg.config.directSGSSmoother)
+    PetscCall(customPressureAMGSGSCorrection(R,lev,rhs,corr,tagBase));
+  else if(R.amg.config.directJacobiSmoother)
+    PetscCall(customPressureAMGJacobiCorrection(R,lev,rhs,corr));
+  else
+    PetscCall(customPressureAMGChebyshevCorrection(R,lev,rhs,corr,tagBase));
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
